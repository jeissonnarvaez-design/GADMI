rules_version = '2';
// La app solo accede a Firestore desde el backend (SDK de administrador, que no usa estas reglas).
// Por seguridad, se bloquea todo acceso directo desde navegadores o apps.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
