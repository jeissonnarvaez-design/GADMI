PORT=3000
# Firebase (Cloud Firestore): ruta del archivo JSON de la cuenta de servicio
FIREBASE_SERVICE_ACCOUNT=./firebase-key.json
CORS_ORIGIN=http://localhost:4200
# Firma de las sesiones: cámbiala en producción
AUTH_SECRET=cambia-este-secreto
# Docente inicial (se crea al arrancar si no hay docentes)
DOCENTE_NOMBRE=Profa. Ana Judith Paredes Chacín
DOCENTE_CORREO=docente@uao.edu.co
DOCENTE_PASSWORD=Docente2026*
# Código que deben escribir los docentes nuevos para registrarse (vacío = registro deshabilitado)
# (Sin uso: ya no hay registro abierto; las cuentas vienen de Moodle o de npm run crear-usuarios)
DOCENTE_CODIGO_REGISTRO=

# Estudiante de prueba para la demostración sin Moodle (déjalo vacío para no crearlo)
DEMO_ESTUDIANTE_CORREO=estudiante.prueba@uao.edu.co
DEMO_ESTUDIANTE_PASSWORD=Prueba2026*
DEMO_ESTUDIANTE_NOMBRE=Estudiante de Prueba
DEMO_ESTUDIANTE_CODIGO=PRUEBA-01
# Periodo académico del código de certificado (p. ej. 2026-2). Vacío = se calcula con la fecha
PERIODO_ACADEMICO=
# Voz de Teo con Gemini (texto a voz). Sin clave, se usa la voz del navegador.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_VOZ_TEO=Charon
# Instrucción de estilo para Teo (opcional). Déjala vacía si Teo la lee en voz alta.
GEMINI_ESTILO_TEO=
# Modelos de respaldo si el principal está saturado (separados por coma)
GEMINI_TTS_FALLBACK=gemini-2.5-flash-preview-tts,gemini-3.8-flash-tts
